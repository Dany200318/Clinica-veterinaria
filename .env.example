# =============================================================
#  Copie este archivo como ".env" y complete los valores.
#  El archivo .env NO se sube a GitHub (está en .gitignore).
# =============================================================

# --- Django ---
# Genere una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
# Hosts permitidos separados por coma. Agregue la IP del servidor en la red local.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# mysql  -> producción (Capítulo VI, sección 6.1.4)
# sqlite -> desarrollo local rápido (no requiere servidor)
DB_ENGINE=mysql
DB_NAME=clinica_veterinaria
DB_USER=clinica_app
DB_PASSWORD=Cl1n1c4_Vet_2026
DB_HOST=localhost
DB_PORT=3306

# --- Correo SMTP (Gmail requiere "contraseña de aplicación") ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=correo.de.la.clinica@gmail.com
EMAIL_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
# Use "console" para ver los correos en la terminal sin enviarlos (pruebas)
EMAIL_MODO=smtp

# --- Datos de la clínica (aparecen en pantallas y correos) ---
CLINICA_NOMBRE=Clínica Veterinaria
CLINICA_TELEFONO=+502 0000-0000
CLINICA_DIRECCION=Amatitlán, Guatemala

# --- Reglas de citas ---
# Duración que se asume cuando una cita no tiene hora de fin
CITA_DURACION_MINUTOS=30
